# Copy to secret.env, replace every value, then run kubectl kustomize deploy/k8s/dev.
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_ADMIN_PASSWORD
AUTH_DB_PASSWORD=REPLACE_WITH_RANDOM_AUTH_DB_PASSWORD
PLAN_DB_PASSWORD=REPLACE_WITH_RANDOM_PLAN_DB_PASSWORD
CHECKIN_DB_PASSWORD=REPLACE_WITH_RANDOM_CHECKIN_DB_PASSWORD
PROFILE_DB_PASSWORD=REPLACE_WITH_RANDOM_PROFILE_DB_PASSWORD
STATISTICS_DB_PASSWORD=REPLACE_WITH_RANDOM_STATISTICS_DB_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_GRAFANA_PASSWORD
